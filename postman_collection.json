{
  "info": {
    "_postman_id": "e9a0e6b5-3120-4e4b-9e0a-7bbce8a1352e",
    "name": "EventEase REST API Collection",
    "description": "Comprehensive Postman collection for EventEase – Multi-Tenant Event & Ticket Reservation System.\nIncludes Authentication, Event Discovery, Atomic 10-Minute Reservations, Mock Payments, Bookings, and Dashboards.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000",
      "type": "string"
    },
    {
      "key": "reservationToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register New User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"alice_wonder\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"SecurePass@123\",\n  \"role\": \"attendee\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login (Attendee)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login_id\": \"attendee@eventease.com\",\n  \"password\": \"Attendee@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login (Organizer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login_id\": \"organizer@eventease.com\",\n  \"password\": \"Organizer@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login_id\": \"admin@eventease.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Events & Discovery",
      "item": [
        {
          "name": "List All Published Events",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/events",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events"]
            }
          }
        },
        {
          "name": "Search & Filter Events",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/events?category=Technology&q=AI",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events"],
              "query": [
                {
                  "key": "category",
                  "value": "Technology"
                },
                {
                  "key": "q",
                  "value": "AI"
                }
              ]
            }
          }
        },
        {
          "name": "Get Event Details & Ticket Tiers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/events/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Ticket Reservations (10-Min Hold)",
      "item": [
        {
          "name": "Create Ticket Reservation Hold",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.reservation && jsonData.reservation.token) {",
                  "    pm.collectionVariables.set('reservationToken', jsonData.reservation.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": 4,\n  \"ticket_type_id\": 1,\n  \"quantity\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/reservations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reservations"]
            }
          }
        },
        {
          "name": "Check Reservation Status & Countdown",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reservation-status/{{reservationToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reservation-status", "{{reservationToken}}"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Mock Payment Checkout",
      "item": [
        {
          "name": "Process Checkout (Force Success)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reservation_token\": \"{{reservationToken}}\",\n  \"user_id\": 4,\n  \"payment_method\": \"Credit Card\",\n  \"force_outcome\": \"SUCCESS\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/checkout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "checkout"]
            }
          }
        },
        {
          "name": "Process Checkout (Force Failure & Rollback)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reservation_token\": \"{{reservationToken}}\",\n  \"user_id\": 4,\n  \"payment_method\": \"Debit Card\",\n  \"force_outcome\": \"FAILED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/checkout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "checkout"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Attendee Bookings",
      "item": [
        {
          "name": "Get User Bookings History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/bookings?user_id=4",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings"],
              "query": [
                {
                  "key": "user_id",
                  "value": "4"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "6. Dashboards & Analytics",
      "item": [
        {
          "name": "Organizer Chart.js Revenue Analytics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/organizer/chart-data",
              "host": ["{{baseUrl}}"],
              "path": ["api", "organizer", "chart-data"]
            }
          }
        },
        {
          "name": "Admin Platform Metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/metrics",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "metrics"]
            }
          }
        }
      ]
    }
  ]
}
